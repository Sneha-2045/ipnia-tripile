# Server
PORT=5000
NODE_ENV=development

# Public API URL used for Cashfree notify_url (webhook)
# Local example: http://localhost:5000
# Production: https://api.ipnia.com
API_PUBLIC_URL=http://localhost:5000

# Frontend origins (CORS)
FRONTEND_URL=https://ipnia.com
# Vite dev server (IPNIA frontend)
FRONTEND_DEV_URL=http://localhost:8080

# MongoDB Atlas
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ipnia?retryWrites=true&w=majority
MONGODB_URI=

# Cashfree Payment Gateway
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# Optional: webhook secret if Cashfree provides a separate signing secret
# Defaults to CASHFREE_CLIENT_SECRET when empty
CASHFREE_WEBHOOK_SECRET=
