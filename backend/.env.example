# Server
PORT=5000
NODE_ENV=development

# Public API URL used for Cashfree notify_url (webhook)
# Local example: http://localhost:5000
# Production: https://api.ipnia.com
API_PUBLIC_URL=http://localhost:5000

# Frontend origins (CORS)
FRONTEND_URL=https://ipnia.com
# Vite dev server (IPNIA frontend)
FRONTEND_DEV_URL=http://localhost:8080

# MongoDB Atlas
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ipnia?retryWrites=true&w=majority
MONGODB_URI=

# Cashfree Payment Gateway
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# Optional: webhook secret if Cashfree provides a separate signing secret
# Defaults to CASHFREE_CLIENT_SECRET when empty
CASHFREE_WEBHOOK_SECRET=

# Duffel Flight Search (server-side ONLY — never expose to Vite/frontend)
# Test: duffel_test_...
# Live: duffel_live_...
DUFFEL_API_KEY=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000
DUFFEL_HTTP_TIMEOUT_MS=25000

# Google Places hotel search (server-side ONLY — never put in VITE_*)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PHOTO_MAX_WIDTH=1200

# Optional FX overrides when Duffel returns non-INR (dashboard billing currency)
# Prefer setting Duffel organisation billing currency to INR in the dashboard.
FX_USD_INR=84
FX_EUR_INR=91
FX_GBP_INR=106
