# Frontend (Vite) — copy to .env and fill values

# Google Gemini API Key (for AI chatbot responses)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Flight / payment / auth API (frontend → IPNIA backend only)
# Production: https://ipnia-tripile.onrender.com
VITE_API_URL=https://ipnia-tripile.onrender.com
# sandbox | production — must match backend CASHFREE_ENV
VITE_CASHFREE_MODE=production

# Auth users are stored in MongoDB via the backend (MONGODB_URI + JWT_SECRET).
# Do not put Mongo credentials in VITE_* variables.
